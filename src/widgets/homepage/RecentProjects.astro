---
import { recentProjects } from "../../data/homepage";
---

<ul class="recent-projects" aria-label="近期开发项目">
  {
    recentProjects.map((project) => (
      <li>
        <a
          class="recent-project-card ui-box ui-border"
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="recent-project-title">{project.title}</span>
          <span class="recent-project-description">{project.description}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .recent-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-projects > li {
    min-inline-size: 0;
  }

  .recent-project-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    min-inline-size: 0;
    block-size: 100%;
    min-block-size: 7rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .recent-project-card:hover {
    border-color: var(--color-primary);
  }

  .recent-project-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .recent-project-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .recent-project-description {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }
</style>
