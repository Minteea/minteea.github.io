---
import LayoutContent from "./LayoutContent.astro";
import FormattedDate from "@components/FormattedDate";
import { getPageTitle } from "@utils/getPageTitle";
import VideoPlayer from "@components/player/VideoPlayer.astro";
import { getCover } from "@data/live-cover-id";
import PlayerMobileTip from "@components/player/PlayerMobileTip.astro";

interface Props {
  data: Record<string, any>;
  isEmpty?: boolean;
}

const { data, isEmpty } = Astro.props;

const { title, description, date, cover, coverId, videoParts, themeColor } =
  data;
---

<LayoutContent pageTitle={getPageTitle(title)} pageDescription={description}>
  <header class="content-header content-header--live">
    <div class="content-header-details">
      <h1 class="content-header-title">{title}</h1>
      <div class="content-header-date">
        <FormattedDate client:load date={date} format="YYYY-MM-DD HH:mm:ss" />
      </div>
    </div>
    <img
      src={cover || getCover(coverId) || ""}
      width={"auto"}
      referrerpolicy="no-referrer"
      alt={title}
      class="content-header-cover"
    />
  </header>
  <div class="content-player">
    {
      videoParts ? (
        <VideoPlayer
          title={title}
          videoParts={videoParts}
          themeColor={themeColor}
        />
      ) : (
        <div class="content-player-empty">暂无回放</div>
      )
    }
  </div>
  <PlayerMobileTip />
  {
    !isEmpty &&(
    <main class="content content-main">
      <slot />
    </main>
    )
  }
</LayoutContent>

<style is:global lang="scss">
  .content-header.content-header--live {
    display: flex;
    justify-content: space-between;
    height: 120px;
    margin-bottom: 1rem;
    background: var(--color-background, #ffffff);
  }

  .content-header-details {
    padding: 1rem;
  }

  .content-header-title {
    margin-top: 0;
  }

  .content-header-date {
    display: flex;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .content-header-cover {
    width: auto;
    background-color: #9ca3af;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .content-player {
    margin-bottom: 0.5rem;
    background: var(--color-background, #ffffff);
  }

  .content-player-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 9rem;
  }

  .content-main {
    min-height: 200px;
    padding: 1rem 1rem 1rem 1rem;
    background: var(--color-background, #ffffff);
  }

  .video-links > a:nth-of-type(n + 2) {
    &::before {
      content: " · ";
    }
  }

  
  @media (max-width: 480px) {
    .content-header-cover{
      display: none;
    }
  }
  @media (max-width: 640px) {
    .content-header-title {
      font-size: 1.25rem;
    }
  }
</style>
