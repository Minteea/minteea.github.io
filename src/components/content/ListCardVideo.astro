---
import FormattedDate from "@components/FormattedDate";
import { getCover } from "@data/live-cover-id";
import type { VideoData } from "@utils/types";

interface Props {
  link: string;
  data: Partial<VideoData>;
}

const { link, data } = Astro.props;
---

<a href={link} class="listcard-video-link">
  <div class="listcard-video">
    <img
      src={data.cover || getCover(data.coverId)}
      class="listcard-video-cover"
      referrerpolicy="no-referrer"
    />
    <div class="listcard-video-details">
      <div class="listcard-video-title">{data.title}</div>
      <div class="listcard-video-date">
        <FormattedDate client:load date={data.date} format="YYYY-MM-DD" />
      </div>
    </div>
  </div>
</a>

<style lang="scss">
  .listcard-video-link {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  .listcard-video {
    display: flex;
    width: 100%;
    height: 90px;
    background: var(--color-background, #ffffff);
  }

  .listcard-video-cover {
    flex-shrink: 0;
    flex-grow: 0;
    width: 160px;
    object-fit: cover;
  }

  .listcard-video-details {
    padding: 0.5rem;
  }

  .listcard-video-title {
    font-size: 1rem;
    font-weight: 700;
    line-clamp: 2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .listcard-video-date {
    font-size: 0.875rem;
  }

</style>
